# ==============================================================================
# PeerCraft Environment Configuration (.env.example)
# ==============================================================================

# Shared Group Secret (Must match across all peer clients and Worker)
GROUP_AUTH_SECRET="your_shared_group_passphrase_here"

# Cloudflare Worker API URL (Deployed Worker Broker)
PEERCRAFT_API_URL="https://peercraft-broker.your-subdomain.workers.dev"

# Backblaze B2 Storage (S3 Compatible API)
B2_KEY_ID="your_backblaze_b2_key_id"
B2_APPLICATION_KEY="your_backblaze_b2_application_key"
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_BUCKET_NAME="peercraft-cluster-data"

# Firebase Realtime Database
FIREBASE_DB_URL="https://your-peercraft-project.firebaseio.com"
FIREBASE_DATABASE_SECRET="your_firebase_secret_key"

# Supabase PostgreSQL (For HuskSync Lockstep State)
SUPABASE_DB_HOST="db.your-project.supabase.co"
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD="your_supabase_db_password"

# Playit.gg Anycast Tunnel Secret
PLAYIT_SECRET_KEY="your_playit_agent_secret_key"

# Local Server Credentials
RCON_PASSWORD="PEERCRAFT_INTERNAL_RCON_PASS_SECURE"
VELOCITY_SECRET="PEERCRAFT_SHARED_VELOCITY_SECRET_KEY_HEX"
